# 일정 API (map-dyoa-server)
# · Vercel 프로덕션/프리뷰: 아래처럼 Fly 주소 권장
# · 로컬에서 로컬 API 쓸 때: http://127.0.0.1:3001
MAP_DYOA_SERVER_URL=https://map-dyoa-server.fly.dev
# 위 URL이 있으면 일정·스트리머·클립 등 도메인 데이터는 Fly API만 사용(Next Prisma 도메인 경로 비활성).
# NextAuth·웹푸시·AuditLog용 (Supabase 예시, & 포함 시 반드시 따옴표)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@....pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@....pooler.supabase.com:5432/postgres?sslmode=require"

# SEO·OG·일정 링크 공유 (로컬 dev에서도 프로덕션 URL로 복사하려면 필수)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# SITE_URL=... 만 있어도 next.config에서 NEXT_PUBLIC_* 로 주입됨

# Axiom (Vercel 로그·map-dyoa-server outbound 요청)
# · Vercel: Marketplace Axiom 연동 시 자동 주입되기도 함
# · 로컬: https://app.axiom.co 에서 dataset + API token 생성
AXIOM_TOKEN=
AXIOM_DATASET=map-dyoa
# (선택) 클라이언트 Web Vitals까지 보낼 때만 NEXT_PUBLIC_* 사용
# NEXT_PUBLIC_AXIOM_TOKEN=
# NEXT_PUBLIC_AXIOM_DATASET=map-dyoa

# (선택) 로컬 개발에서 원격 피드백 API만 실패할 때 Prisma 폴백 끄기: 0
# FEEDBACK_DEV_PRISMA_FALLBACK=0

# Account 백업(.enc) 암호화 키 — 없으면 AUTH_SECRET 사용
# BACKUP_ENCRYPTION_KEY=

# Vercel Cron (/api/cron/backend-health) — Production에 설정하면 Vercel이 Bearer로 자동 첨부
# CRON_SECRET=
