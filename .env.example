# 일정 API (map-dyoa-server)
# · Vercel 프로덕션/프리뷰: 아래처럼 Fly 주소 권장
# · 로컬에서 로컬 API 쓸 때: http://127.0.0.1:3001
MAP_DYOA_SERVER_URL=https://map-dyoa-server.fly.dev
# 위 URL이 있으면 일정·스트리머·클립 등 도메인 데이터는 Fly API만 사용(Next Prisma 도메인 경로 비활성).
# NextAuth·웹푸시용 DATABASE_URL은 Vercel에 별도로 두면 됩니다.

# SEO·OG canonical (프로덕션 도메인, 예: https://map-dyoa.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Axiom (Vercel 로그·map-dyoa-server outbound 요청)
# · Vercel: Marketplace Axiom 연동 시 자동 주입되기도 함
# · 로컬: https://app.axiom.co 에서 dataset + API token 생성
AXIOM_TOKEN=
AXIOM_DATASET=map-dyoa
# (선택) 클라이언트 Web Vitals까지 보낼 때만 NEXT_PUBLIC_* 사용
# NEXT_PUBLIC_AXIOM_TOKEN=
# NEXT_PUBLIC_AXIOM_DATASET=map-dyoa

# (선택) 로컬 개발에서 원격 피드백 API만 실패할 때 Prisma 폴백 끄기: 0
# FEEDBACK_DEV_PRISMA_FALLBACK=0
