// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Streamer {
  id         String  @id @default(cuid())
  name       String  @unique
  handle     String  @unique // URL용 ID (예: chimchakman)
  generation Int     @default(1) // 1기, 2기 등
  role       String? // 부장, 부부장, 멤버 등
  platform   String  @default("CHZZK")
  profileImg String?
  colorCode  String  @default("#673AB7") // 캘린더 표시 색상
  chzzkUrl   String?
  youtubeUrl String?
  bio        String? @db.Text
  isGuest    Boolean @default(false)

  schedules        ScheduleParticipant[]
  clipParticipants ClipParticipant[]
  createdAt        DateTime              @default(now())
}

model Schedule {
  id          String    @id @default(cuid())
  title       String
  content     String?
  startTime   DateTime
  endTime     DateTime?
  isGuerrilla Boolean   @default(false)
  isNaeJeon   Boolean   @default(false)
  isLiveEnded Boolean   @default(false)
  liveUrls    String[]

  participants ScheduleParticipant[]
  clips        Clip[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  game         Game?                 @relation(fields: [gameId], references: [id])
  gameId       String?
}

model ScheduleParticipant {
  id         String   @id @default(cuid())
  scheduleId String
  streamerId String
  nation     String?
  result     String?
  isGuest    Boolean  @default(false)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  streamer   Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, streamerId])
  @@index([scheduleId])
  @@index([streamerId])
}

model Game {
  id        String     @id @default(cuid())
  title     String     @unique
  isHoi4    Boolean    @default(false)
  schedules Schedule[]
}

model Clip {
  id           String            @id @default(cuid())
  title        String
  url          String
  thumbnailUrl String?
  description  String?
  clipDate     DateTime?
  participants ClipParticipant[]
  scheduleId   String?
  schedule     Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([scheduleId])
}

model ClipParticipant {
  id         String   @id @default(cuid())
  clipId     String
  streamerId String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  streamer   Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([clipId, streamerId])
  @@index([clipId])
  @@index([streamerId])
}

model Feedback {
  id       String @id @default(cuid())
  type     String // 예: "EDIT_REQUEST" (수정 요청), "GENERAL" (일반 피드백)
  category String // 예: "닉네임 오류", "정보 수정" 등
  content  String @db.Text

  // 어떤 스트리머에 대한 요청인지 (선택 사항)
  streamerId   String?
  streamerName String? // 스트리머가 삭제될 경우를 대비한 스냅샷

  status    String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([streamerId])
}

// prisma/schema.prisma

/// Auth.js 사용자 — Google OAuth는 Account(provider+providerAccountId)로만 연결, 프로필 PII 미저장
model User {
  id        String    @id @default(cuid())
  role      String    @default("USER")
  accounts  Account[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PushSubscription {
  id             String            @id @default(cuid())
  endpoint       String            @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reminderLogs   PushReminderLog[]
}

model PushReminderLog {
  id             String           @id @default(cuid())
  subscriptionId String
  scheduleId     String
  scheduledFor   DateTime
  sentAt         DateTime         @default(now())
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, scheduleId])
  @@index([scheduleId, scheduledFor])
}

/// 사이트 긴급 공지/장애 안내 배너 (항상 살아있는 Prisma DB에 저장 — 도메인 서버 장애 시에도 노출 가능)
model SiteNotice {
  id        String      @id @default(cuid())
  level     NoticeLevel @default(INFO)
  title     String
  body      String?     @db.Text
  active    Boolean     @default(true)
  startsAt  DateTime? // 예약 게시 시작 (null이면 즉시)
  endsAt    DateTime? // 자동 만료 시각 (null이면 무기한)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([active, startsAt, endsAt])
}

enum NoticeLevel {
  INFO
  WARNING
  URGENT
}

/// 백엔드 헬스 체크 원시 샘플 (Cron 5분 간격)
model BackendHealthCheck {
  id         String   @id @default(cuid())
  checkedAt  DateTime @default(now())
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?

  @@index([checkedAt])
}

/// KST 날짜별 집계 (YYYY-MM-DD)
enum BackendHealthDayStatus {
  OK
  DEGRADED
  DOWN
}

model BackendHealthDay {
  dateKst      String                   @id
  totalChecks  Int
  okChecks     Int
  avgLatencyMs Int?
  maxLatencyMs Int?
  status       BackendHealthDayStatus
  updatedAt    DateTime                 @updatedAt

  @@index([dateKst(sort: Desc)])
}

/// HOI4 호이고사 등 — 수동 출발·종료 (7시 자동 시작 대신 운영자 제어)
model Hoi4ExamState {
  examId          String    @id
  manualStartedAt DateTime?
  manualEndedAt   DateTime?
  updatedAt       DateTime  @updatedAt
}

/// HOI4 호이고사 멤버별 클리어 기록
model Hoi4ExamEntry {
  examId        String
  streamerId    String
  clearGameDate String?
  playTimeMs    Int?
  clearedAtKst  String?
  vodUrl        String?
  updatedAt     DateTime @updatedAt

  @@id([examId, streamerId])
  @@index([examId])
}

/// 관리자용 변경 이력 (Next 서버 액션에서 기록)
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  summary     String
  changes     Json?
  actorUserId String?
  actorRole   String?
  createdAt   DateTime @default(now())

  @@index([entity, createdAt(sort: Desc)])
  @@index([entityId])
}
