{
  "name": "map-dyoa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:ensure-youtube-column": "prisma db execute --schema prisma/schema.prisma --file scripts/add-streamer-youtube-url.sql",
    "db:backup-account": "prisma db execute --schema prisma/schema.prisma --file scripts/backup-account.sql",
    "db:restore-account": "prisma db execute --schema prisma/schema.prisma --file scripts/restore-account-from-backup.sql",
    "db:export-account": "node scripts/export-account-backup.mjs",
    "db:export-app": "node scripts/export-db-without-auth.mjs",
    "db:decrypt-export": "node scripts/decrypt-app-export.mjs",
    "db:decrypt-account": "node scripts/decrypt-account-backup.mjs",
    "db:encrypt-account-backups": "node scripts/encrypt-account-backup-plain.mjs",
    "db:strip-auth-pii": "prisma db execute --schema prisma/schema.prisma --file scripts/strip-auth-pii.sql",
    "configure:git-commit": "git config commit.template .gitmessage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-axiom": "^1.10.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.10.0",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
