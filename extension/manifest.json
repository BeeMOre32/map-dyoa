{
  "manifest_version": 3,
  "name": "Map-Dyoa 멀티뷰 도우미",
  "description": "map-dyoa 멀티뷰에서 치지직 방송을 시청할 수 있도록 iframe 제한을 해제합니다.",
  "version": "1.2.16",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequestWithHostAccess", "cookies", "alarms"],
  "host_permissions": [
    "*://*.naver.com/*",
    "*://map-doya.site/*",
    "*://www.map-doya.site/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://map-doya.site/*",
      "https://www.map-doya.site/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://map-doya.site/*",
        "*://www.map-doya.site/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["presence.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://chzzk.naver.com/*", "*://m.chzzk.naver.com/*"],
      "js": ["chzzk.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://chzzk.naver.com/*", "*://m.chzzk.naver.com/*"],
      "js": ["preview-early.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_chzzk",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
